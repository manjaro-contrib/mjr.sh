{
  "name": "mjr.sh",
  "description": "A simple URL shortener for manjaro friends.",
  "version": "1.0.0",
  "author": {
    "email": "info@jonas-strassel.de",
    "name": "Jonas Strassel",
    "url": "https://jonas-strassel.de"
  },
  "license": "MIT",
  "repository": {
    "url": "https://mjr.sh/C736"
  },
  "keywords": [
    "url",
    "shortener",
    "manjaro"
  ],
  "scripts": {
    "build": "bunx markdown-to-html-cli --style ./assets/style.css",
    "db:purge": "bunx wrangler d1 execute urls --file=./schema.sql",
    "dev": "bunx wrangler pages dev --d1 urls",
    "check": "bunx @biomejs/biome check --apply **/*.{ts,json}"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@cloudflare/workers-types": "^4.20260509.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "kysely": "^0.29.0",
    "kysely-d1": "^0.4.0",
    "zod": "^4.4.3"
  },
  "markdown-to-html": {
    "favicon": "/assets/favicon.svg"
  },
  "packageManager": "bun@1.3.12"
}
